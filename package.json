{
  "name": "capi-uploader",
  "productName": "CapiUploader",
  "version": "1.3.0",
  "description": "Sube capítulos de manga a Capibara Traductor mediante su API.",
  "main": "src/main/main.js",
  "author": "SenshiManga",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.senshimanga.capiuploader",
    "productName": "CapiUploader",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "CapiUploader",
      "runAfterFinish": true,
      "artifactName": "CapiUploader-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CapiUploader-Portable-${version}.${ext}",
      "useZip": true
    },
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ],
    "compression": "normal",
    "extraResources": [
      {
        "from": "vendor/psdc",
        "to": "psdc",
        "filter": [
          "psdc.exe",
          "LICENSE"
        ]
      }
    ]
  },
  "devDependencies": {
    "devalue": "^6.0.3",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "exifr": "^7.1.3",
    "protobufjs": "^8.8.1"
  }
}
